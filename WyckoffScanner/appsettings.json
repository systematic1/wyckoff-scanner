{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=wyckoff;Username=postgres;Password=CHANGE_ME"
  },

  "Yahoo": {
    "Source": "Html",
    "QuoteBaseUrl": "https://finance.yahoo.com/quote/",
    "ChartApiBaseUrl": "https://query1.finance.yahoo.com/v8/finance/chart/",
    "DelayBetweenCallsMinutes": 3,
