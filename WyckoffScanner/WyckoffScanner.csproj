<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WyckoffScanner</RootNamespace>
    <UserSecretsId>wyckoff-scanner-6f1c2b7a</UserSecretsId>
    <PackageId>WyckoffScanner</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WyckoffScanner.Lib\WyckoffScanner.Lib.csproj" />
  </ItemGroup>

</Project>
